# ==============================================================================
# BUYERA — Environment Variables Contract (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (Transaction Pooler + Direct Session URL)
# ------------------------------------------------------------------------------
# Transaction pooler URL (Port 6543) for serverless queries with pgbouncer:
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]: Sagar@8001930546 @aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (Port 5432) for Prisma migrations and schema updates:
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. NextAuth & Security Secret
# ------------------------------------------------------------------------------
# Run `openssl rand -base64 32` to generate a secure secret:
NEXTAUTH_SECRET="buyera_jwt_super_secure_production_secret_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway
# ------------------------------------------------------------------------------
# Razorpay Key ID (public key used in client-side checkout modal):
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Razorpay Key Secret (private key used in server-side signature verification):
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Webhook Secret for Razorpay payment events:
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ------------------------------------------------------------------------------
# 4. Shiprocket Logistics Integration
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL="logistics@buyera.in"
SHIPROCKET_PASSWORD="your_shiprocket_password"
SHIPROCKET_API_BASE_URL="https://apiv2.shiprocket.in/v1/external"

# ------------------------------------------------------------------------------
# 5. Supabase API & Cloud Media Storage
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_REST_URL="https://[YOUR_PROJECT_REF].supabase.co/rest/v1/"
SUPABASE_REST_URL="https://[YOUR_PROJECT_REF].supabase.co/rest/v1/"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"
SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_public_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key_here"

# ------------------------------------------------------------------------------
# 6. Public Application Domain & Metadata
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="BUYERA"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_DEFAULT_FREE_SHIPPING_THRESHOLD="999"